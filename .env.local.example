# Copy this file to .env.local and replace the placeholder values.
# These variables are safe to expose to the browser because they are the
# public project URL and the public anon key, not the secret service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-goes-here
