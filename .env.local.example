# 1) Copy this file and rename the copy to .env.local
# 2) Paste your real values on the right side of each = sign
# 3) Restart npm run dev after editing

# Default values your app can use right away.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Optional: localStorage key name used by the Configuration page.
NEXT_PUBLIC_AUTH_CONFIG_STORAGE_KEY=demo-auth-config
